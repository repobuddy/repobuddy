{
	"name": "dual-ts-swc",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rimraf cjs esm tslib --glob *.tsbuildinfo",
		"coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --coverage",
		"test": " cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
		"test:jest": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
		"test:jest:bundle": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --config jest.config.bundle.cjs",
		"test:list": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --list-tests",
		"test:vitest": "vitest run",
		"test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --watch"
	},
	"dependencies": {
		"chalk": "^6.0.0",
		"strip-ansi": "^7.0.1",
		"type-plus": "^7.6.2",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@repobuddy/jest": "workspace:^",
		"@repobuddy/typescript": "workspace:^",
		"@types/jest": "^30.0.0",
		"assertron": "^11.0.3",
		"cross-env": "^10.1.0",
		"dirname-filename-esm": "^1.1.1",
		"jest": "^30.0.0",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config-2": "^2.1.0",
		"jest-watch-typeahead": "^3.0.0",
		"rimraf": "^6.0.1",
		"ts-jest": "29.4.12",
		"typescript": "^6.0.0",
		"vitest": "^4.1.4"
	}
}