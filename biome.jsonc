{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		// The vendor plugin manifests are build output of `universal-plugin plugin build`.
		// Formatting them here would fight the generator on every build.
		"includes": [
			"!**/tests/performant",
			"!**/tests/.config",
			"!.agents",
			"!**/.claude-plugin",
			"!**/.cursor-plugin",
			"!**/.codex-plugin",
			// Compiled by `plugin build` from packages/buddy/src/skills/; committed, never edited.
			"!packages/buddy/skills/to-question/scripts",
			"!packages/buddy/skills/review-permissions/scripts",
			"!packages/buddy/skills/epic/scripts/epic-plan.mjs",
			"!packages/buddy/skills/init-buddy/scripts/auto-mode.mjs",
			"!packages/buddy/skills/init-buddy/scripts/permission-candidates.mjs",
			// CLI forwarders written by `plugin build` from the `forward` entries in plugin.json.
			"!packages/buddy/skills/*/scripts/repobuddy.mjs",
			"!packages/buddy/skills/agent-readiness/scripts/aced-bench.mjs",
			"!packages/buddy/skills/repo/scripts/cyber-agentkit.mjs",
			"!packages/buddy/skills/*/scripts/cyber-skills.mjs",
			// Eval results written by cyber-agentkit `skill test` and `skill accept`; committed, never edited.
			"!packages/buddy/skills/*/evals/**/expected.json",
			"!packages/buddy/skills/*/evals/**/accepted"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"overrides": [
		{
			// A fragment pre-indented to paste under `pipelines: custom:`; the formatter would dedent it.
			"includes": ["packages/buddy/skills/min-release-age/assets/ci/bitbucket.yml"],
			"formatter": { "enabled": false }
		},
		{
			// Repo maintenance CLIs: printing is their output, and they read their own env config.
			"includes": ["**/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noUndeclaredEnvVars": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/typescript/tsconfig/**/*.json"],
			"json": {
				"parser": { "allowComments": true }
			}
		},
		{
			// Standalone .svg asset files get their accessible name where they are
			// used (e.g. `<img alt>`), not inside the file. The a11y rule targets
			// inline SVG elements, so it is a false positive here.
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"a11y": { "noSvgWithoutTitle": "off" }
				}
			}
		}
	],
	"linter": {
		"rules": {
			"style": {
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
