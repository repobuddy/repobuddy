{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		// The vendor plugin manifests are build output of `universal-plugin plugin build`.
		// Formatting them here would fight the generator on every build.
		"includes": [
			"!**/tests/performant",
			"!**/tests/.config",
			"!.agents",
			"!**/.claude-plugin",
			"!**/.cursor-plugin",
			"!**/.codex-plugin"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"overrides": [
		{
			// Repo maintenance CLIs: printing is their output, and they read their own env config.
			"includes": ["**/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noUndeclaredEnvVars": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/typescript/tsconfig/**/*.json"],
			"json": {
				"parser": { "allowComments": true }
			}
		},
		{
			// Standalone .svg asset files get their accessible name where they are
			// used (e.g. `<img alt>`), not inside the file. The a11y rule targets
			// inline SVG elements, so it is a false positive here.
			"includes": ["**/*.svg"],
			"linter": {
				"rules": {
					"a11y": { "noSvgWithoutTitle": "off" }
				}
			}
		}
	],
	"linter": {
		"rules": {
			"style": {
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
