{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"//#check": {},
		// knip reads each package's `exports` map, and the jest testcases' configs
		// resolve `@repobuddy/jest` through its built `cjs/` output, so the
		// workspace has to be built first — same reason the old `depcheck` task
		// depended on `build`.
		"//#knip": {
			"dependsOn": [
				"@repobuddy/jest#build",
				"@repobuddy/test#build",
				"@repobuddy/typescript#build",
				"@repobuddy/vitest#build",
				"repobuddy#build"
			]
		},
		"//#lint": {},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "package.json", "tsconfig.*"],
			"outputs": ["cjs/**", "dist/**", "esm/**", "tslib/**", "*.tsbuildinfo"]
		},
		"build:doc": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		},
		"coverage": {
			"dependsOn": ["@repobuddy/jest#build", "@repobuddy/vitest#build", "build"],
			"inputs": ["src/**", "package.json", "tsconfig.*"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false
		},
		"size": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["@repobuddy/jest#build", "@repobuddy/vitest#build", "build"],
			"inputs": ["src/**", "package.json", "tsconfig.*"]
		},
		"test:list": {
			"dependsOn": ["build"],
			"inputs": ["src/**", "package.json"]
		}
	}
}