{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "repobuddy",
	"version": "2.2.0",
	"description": "Agent skills for managing a repository — issues, dependency PRs, GitHub Pages, repo setup, and npm trusted publishing.",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"homepage": "https://github.com/repobuddy/repobuddy",
	"repository": "https://github.com/repobuddy/repobuddy.git",
	"license": "MIT",
	"keywords": ["agent-skills", "repository", "github", "automation", "cli"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"vendors": ["claude-code", "cursor", "codex", "copilot-cli"],
			"skills": "./skills/",
			"harnesses": {
				"claude-code": {},
				"cursor": {
					"publisher": "repobuddy",
					"category": "productivity",
					"tags": ["repository", "github", "automation"]
				},
				"codex": {
					"interface": {
						"displayName": "Repobuddy",
						"category": "productivity"
					}
				},
				"copilot-cli": {}
			},
			"scripts": {
				"skills/to-question/scripts/check-format.mjs": "src/skills/check-format.ts",
				"skills/to-question/scripts/question-path.mjs": "src/skills/question-path.ts",
				"skills/review-permissions/scripts/scan-permissions.mjs": "src/skills/scan-permissions.ts"
			}
		}
	}
}