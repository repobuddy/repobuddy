{
	"name": "repobuddy",
	"version": "4.0.1",
	"description": "Your Repobuddy CLI",
	"keywords": [
		"cli",
		"repository",
		"tools",
		"jest",
		"typescript"
	],
	"homepage": "https://github.com/repobuddy/repobuddy",
	"bugs": {
		"url": "https://github.com/repobuddy/repobuddy/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/repobuddy.git",
		"directory": "packages/buddy"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"bin": {
		"bd": "./bin/buddy.js",
		"buddy": "./bin/buddy.js",
		"repobuddy": "./bin/buddy.js"
	},
	"exports": {
		"./package.json": "./package.json"
	},
	"files": [
		"esm",
		"templates",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*",
		"plugin.json",
		"skills/",
		"references/",
		".claude-plugin/plugin.json",
		".cursor-plugin/plugin.json",
		".codex-plugin/plugin.json",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc --noEmit && tsdown && universal-plugin plugin build --root .",
		"clean": "rimraf coverage esm tslib --glob *.tsbuildinfo",
		"coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" NODE_NO_WARNINGS=1 jest --coverage",
		"nuke": "run-s clean && rimraf node_modules",
		"prepack": "pnpm build",
		"test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" jest",
		"test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" jest --watch",
		"typecheck": "tsc --noEmit",
		"pack:check": "node scripts/check-pack.mjs",
		"verify": "npm-run-all -p build typecheck -p test"
	},
	"devDependencies": {
		"@clibuilder/plugins": "0.2.0",
		"cyber-agentkit": "^1.0.0",
		"@jest/globals": "^30.0.0",
		"@repobuddy/jest": "workspace:*",
		"buddy-agent-harness": "^0.22.0",
		"clibuilder": "^12.0.0",
		"cross-env": "^10.1.0",
		"cyber-mux": "^0.10.0",
		"jest": "^30.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.0",
		"universal-plugin": "^0.16.0"
	},
	"dependencies": {
		"args-minus": "0.2.0"
	}
}