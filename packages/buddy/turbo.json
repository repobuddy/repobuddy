{
	"$schema": "https://turborepo.org/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": [
				"$TURBO_EXTENDS$",
				"skills/min-release-age/scripts/min-release-age.mjs",
				"skills/*/scripts/repobuddy.mjs",
				"skills/agent-readiness/scripts/aced-bench.mjs",
				"skills/repo/scripts/cyber-agentkit.mjs",
				"skills/*/scripts/cyber-skills.mjs",
				"skills/to-question/scripts/check-format.mjs",
				"skills/to-question/scripts/question-path.mjs",
				"skills/review-permissions/scripts/scan-permissions.mjs"
			]
		},
		"pack:check": {
			"dependsOn": ["build"],
			"cache": false
		}
	}
}